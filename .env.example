# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง
# ห้าม commit ไฟล์ที่มีคีย์

# Project URL จาก Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=

# anon key หรือ publishable key ฝั่งเบราว์เซอร์ ไม่ใช่ service_role
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ใช้บนเซิร์ฟเวอร์เท่านั้น สำหรับบันทึกคลิกและลงทะเบียนอีเมลผู้ดูแล
SUPABASE_SERVICE_ROLE_KEY=

# อีเมลผู้ดูแล คั่นด้วยจุลภาค ตัวพิมพ์ใหญ่เล็กไม่สน
ADMIN_EMAILS=

# ที่อยู่เว็บ ไม่ต้องใส่ / ท้าย
NEXT_PUBLIC_SITE_URL=https://songsoul-deals.vercel.app
